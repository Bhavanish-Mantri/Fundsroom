generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @map("company_name")
  contactPerson String   @map("contact_person")
  mobile        String
  email         String
  city          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@unique([companyName, email])
  @@index([companyName])
  @@index([email])
  @@map("customers")
}

model Product {
  id          Int      @id @default(autoincrement())
  productCode String   @unique @map("product_code")
  name        String
  category    String
  unit        String
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique @map("product_id")
  physicalQty Int      @map("physical_quantity") @db.Integer
  reservedQty Int      @default(0) @map("reserved_quantity") @db.Integer
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("inventory")
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique @map("enquiry_number")
  customerId    Int           @map("customer_id")
  enquiryDate   DateTime      @map("enquiry_date")
  requiredDate  DateTime?     @map("required_date")
  notes         String?
  status        EnquiryStatus
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      EnquiryItem[]
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  id        Int      @id @default(autoincrement())
  enquiryId Int      @map("enquiry_id")
  productId Int      @map("product_id")
  quantity  Int      @db.Integer
  createdAt DateTime @default(now()) @map("created_at")

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([enquiryId, productId])
  @@index([enquiryId])
  @@index([productId])
  @@map("enquiry_items")
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       Int             @map("enquiry_id")
  customerId      Int             @map("customer_id")
  validUntil      DateTime        @map("valid_until")
  status          QuotationStatus
  grandTotal      Decimal         @map("grand_total") @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  enquiry    Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([enquiryId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          Int      @id @default(autoincrement())
  quotationId Int      @map("quotation_id")
  productId   Int      @map("product_id")
  quantity    Int      @db.Integer
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPct Decimal  @map("discount_pct") @db.Decimal(5, 2)
  gstPct      Decimal  @map("gst_pct") @db.Decimal(5, 2)
  lineAmount  Decimal  @map("line_amount") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quotationId, productId])
  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique @map("order_number")
  quotationId Int?             @unique @map("quotation_id")
  customerId  Int              @map("customer_id")
  orderDate   DateTime         @map("order_date")
  totalAmount Decimal          @map("total_amount") @db.Decimal(12, 2)
  status      SalesOrderStatus
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  quotation  Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      SalesOrderItem[]
  dispatches Dispatch[]

  @@index([customerId])
  @@index([status])
  @@index([quotationId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           Int      @id @default(autoincrement())
  salesOrderId Int      @map("sales_order_id")
  productId    Int      @map("product_id")
  quantity     Int      @db.Integer
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, productId])
  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatchNumber String   @unique @map("dispatch_number")
  salesOrderId   Int      @map("sales_order_id")
  dispatchDate   DateTime @map("dispatch_date")
  vehicleNumber  String?  @map("vehicle_number")
  driverName     String?  @map("driver_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items      DispatchItem[]

  @@index([salesOrderId])
  @@map("dispatches")
}

model DispatchItem {
  id         Int      @id @default(autoincrement())
  dispatchId Int      @map("dispatch_id")
  productId  Int      @map("product_id")
  quantity   Int      @db.Integer
  createdAt  DateTime @default(now()) @map("created_at")

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@index([dispatchId])
  @@index([productId])
  @@map("dispatch_items")
}
